# Рядок підключення MongoDB Atlas (https://cloud.mongodb.com/)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/haven?retryWrites=true&w=majority

# Порт Express-сервера
PORT=3000

# Секретний ключ для підпису JWT-токенів (замініть на власний довгий рядок)
JWT_SECRET=change_this_to_a_long_random_secret_key

# Дозволені домени фронтенду для CORS (через кому)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Опціонально для окремого деплою фронтенду: URL вашого бекенду на Render
# VITE_API_URL=https://your-backend.onrender.com/api
